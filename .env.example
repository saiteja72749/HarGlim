# Copy to .env.local for local development. Production values live in netlify.toml
# ([build.environment]); anything set in the Netlify UI overrides them.
# All NEXT_PUBLIC_* values are inlined into the browser bundle at build time: never put
# secrets in them, and redeploy after changing one.

# Backend API base URL (Render).
NEXT_PUBLIC_API_URL=https://harglimpublish-backend.onrender.com/api

# Public site URL used for canonical links, sitemap.xml, robots.txt and Open Graph.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sign-In OAuth client ID (public). Add each site origin (localhost, the
# *.netlify.app URL, harglimpublishers.com) to its Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=13886691041-flfn7g4qteies5jul4efud04v826oc3q.apps.googleusercontent.com

# Optional: set to true to open the bundle analyzer during `npm run build`.
# ANALYZE=true
